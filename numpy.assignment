  {
   "cell_type": "markdown",
   "id": "9dfb52cc-c39c-46fb-99ef-fc344c81d2bf",
   "metadata": {},
   "source": [
    "## Calculate summary statistics ##"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "4c60ac27-68f6-417c-9ff8-954a89ab70f9",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Mean Salary: 43500.0\n",
      "Maximum Salary: 58000\n",
      "Minimum Salary: 35000\n",
      "Median Salary: 40500.0\n",
      "Average Age: 28.25\n"
     ]
    }
   ],
   "source": [
    "\n",
    "import pandas as pd\n",
    "\n",
    "df = pd.DataFrame({\n",
    "    'EmpID': [101, 102, 103, 104],\n",
    "    'Name': ['Arun', 'Priya', 'Kumar', 'Divya'],\n",
    "    'Department': ['IT', 'HR', 'IT', 'Finance'],\n",
    "    'Age': [25, 29, 32, 27],\n",
    "    'Salary': [35000, 42000, 58000, 39000],\n",
    "    'Experience': [2, 5, 8, 3],\n",
    "    'City': ['Chennai', 'Madurai', 'Chennai', 'Chennai']\n",
    "})\n",
    "\n",
    "print(\"Mean Salary:\", df['Salary'].mean())\n",
    "print(\"Maximum Salary:\", df['Salary'].max())\n",
    "print(\"Minimum Salary:\", df['Salary'].min())\n",
    "print(\"Median Salary:\", df['Salary'].median())\n",
    "\n",
    "print(\"Average Age:\", df['Age'].mean())\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9a423623-016e-44e0-9efc-6676ccfdd5b4",
   "metadata": {},
   "source": [
    "## Group by department ##"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "6db71fc2-ea2d-4623-8885-53d2927c6442",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "            Number_of_Employees  Average_Salary  Highest_Salary\n",
      "Department                                                     \n",
      "IT                            2         46500.0           58000\n",
      "HR                            1         42000.0           42000\n",
      "Finance                       1         39000.0           39000\n"
     ]
    }
   ],
   "source": [
    "\n",
    "import pandas as pd\n",
    "\n",
    "df = pd.DataFrame({\n",
    "    'EmpID': [101, 102, 103, 104],\n",
    "    'Name': ['Arun', 'Priya', 'Kumar', 'Divya'],\n",
    "    'Department': ['IT', 'HR', 'IT', 'Finance'],\n",
    "    'Age': [25, 29, 32, 27],\n",
    "    'Salary': [35000, 42000, 58000, 39000],\n",
    "    'Experience': [2, 5, 8, 3],\n",
    "    'City': ['Chennai', 'Madurai', 'Chennai', 'Chennai']\n",
    "})\n",
    "\n",
    "result = df.groupby('Department').agg(\n",
    "    Number_of_Employees=('EmpID', 'count'),\n",
    "    Average_Salary=('Salary', 'mean'),\n",
    "    Highest_Salary=('Salary', 'max')\n",
    ")\n",
    "\n",
    "result = result.sort_values(\n",
    "    by='Average_Salary',\n",
    "    ascending=False\n",
    ")\n",
    "\n",
    "print(result)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "0e62c92c-49dc-4ebe-ab7a-253f171b478b",
   "metadata": {},
   "source": [
    "## Create a new column ##"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "b207dca9-e8a8-47d3-a1ff-9b60cdf27a39",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "    Name  Salary  AnnualSalary\n",
      "0   Arun   35000        420000\n",
      "1  Priya   42000        504000\n",
      "2  Kumar   58000        696000\n",
      "3  Divya   39000        468000\n"
     ]
    }
   ],
   "source": [
    "\n",
    "import pandas as pd\n",
    "\n",
    "df = pd.DataFrame({\n",
    "    'EmpID': [101, 102, 103, 104],\n",
    "    'Name': ['Arun', 'Priya', 'Kumar', 'Divya'],\n",
    "    'Department': ['IT', 'HR', 'IT', 'Finance'],\n",
    "    'Age': [25, 29, 32, 27],\n",
    "    'Salary': [35000, 42000, 58000, 39000],\n",
    "    'Experience': [2, 5, 8, 3],\n",
    "    'City': ['Chennai', 'Madurai', 'Chennai', 'Chennai']\n",
    "})\n",
    "\n",
    "df['AnnualSalary'] = df['Salary'] * 12\n",
    "\n",
    "print(df[['Name', 'Salary', 'AnnualSalary']])\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "709521b9-b1a4-40f6-8f8b-5c602341ba90",
   "metadata": {},
   "source": [
    "## Find missing and duplicate values ##"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "id": "dfa22879-b0a6-4aeb-9034-4fd4ba8d9112",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "DataFrame with missing value and duplicate row:\n",
      "   EmpID   Name Department  Age  Salary  Experience     City\n",
      "0    101   Arun         IT   25   35000           2      NaN\n",
      "1    102  Priya         HR   29   42000           5  Madurai\n",
      "2    103  Kumar         IT   32   58000           8  Chennai\n",
      "3    104  Divya    Finance   27   39000           3  Chennai\n",
      "4    102  Priya         HR   29   42000           5  Madurai\n",
      "\n",
      "Missing Values:\n",
      "EmpID         0\n",
      "Name          0\n",
      "Department    0\n",
      "Age           0\n",
      "Salary        0\n",
      "Experience    0\n",
      "City          1\n",
      "dtype: int64\n",
      "\n",
      "After filling missing values:\n",
      "   EmpID   Name Department  Age  Salary  Experience     City\n",
      "0    101   Arun         IT   25   35000           2  Unknown\n",
      "1    102  Priya         HR   29   42000           5  Madurai\n",
      "2    103  Kumar         IT   32   58000           8  Chennai\n",
      "3    104  Divya    Finance   27   39000           3  Chennai\n",
      "4    102  Priya         HR   29   42000           5  Madurai\n",
      "\n",
      "After removing duplicate rows:\n",
      "   EmpID   Name Department  Age  Salary  Experience     City\n",
      "0    101   Arun         IT   25   35000           2  Unknown\n",
      "1    102  Priya         HR   29   42000           5  Madurai\n",
      "2    103  Kumar         IT   32   58000           8  Chennai\n",
      "3    104  Divya    Finance   27   39000           3  Chennai\n"
     ]
    }
   ],
   "source": [
    "\n",
    "import pandas as pd\n",
    "\n",
    "# Create the employee DataFrame\n",
    "df = pd.DataFrame({\n",
    "    'EmpID': [101, 102, 103, 104],\n",
    "    'Name': ['Arun', 'Priya', 'Kumar', 'Divya'],\n",
    "    'Department': ['IT', 'HR', 'IT', 'Finance'],\n",
    "    'Age': [25, 29, 32, 27],\n",
    "    'Salary': [35000, 42000, 58000, 39000],\n",
    "    'Experience': [2, 5, 8, 3],\n",
    "    'City': ['Chennai', 'Madurai', 'Chennai', 'Chennai']\n",
    "})\n",
    "\n",
    "df_copy = df.copy()\n",
    "\n",
    "df_copy.loc[0, 'City'] = None\n",
    "\n",
    "df_copy = pd.concat(\n",
    "    [df_copy, df_copy.iloc[[1]]],\n",
    "    ignore_index=True\n",
    ")\n",
    "\n",
    "print(\"DataFrame with missing value and duplicate row:\")\n",
    "print(df_copy)\n",
    "\n",
    "print(\"\\nMissing Values:\")\n",
    "print(df_copy.isnull().sum())\n",
    "\n",
    "df_copy['City'] = df_copy['City'].fillna('Unknown')\n",
    "\n",
    "print(\"\\nAfter filling missing values:\")\n",
    "print(df_copy)\n",
    "\n",
    "df_copy = df_copy.drop_duplicates()\n",
    "\n",
    "print(\"\\nAfter removing duplicate rows:\")\n",
    "print(df_copy)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4eff25fc-4a0a-41fc-aec3-ef70fa05d287",
   "metadata": {},
   "source": [
    "## Use conditional logic ##"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "id": "2b25585c-c8bf-4f5c-aee4-c3b7fbd435fe",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "    Name  Salary SalaryLevel\n",
      "0   Arun   35000         Low\n",
      "1  Priya   42000      Medium\n",
      "2  Kumar   58000        High\n",
      "3  Divya   39000         Low\n"
     ]
    }
   ],
   "source": [
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "df = pd.DataFrame({\n",
    "    'EmpID': [101, 102, 103, 104],\n",
    "    'Name': ['Arun', 'Priya', 'Kumar', 'Divya'],\n",
    "    'Department': ['IT', 'HR', 'IT', 'Finance'],\n",
    "    'Age': [25, 29, 32, 27],\n",
    "    'Salary': [35000, 42000, 58000, 39000],\n",
    "    'Experience': [2, 5, 8, 3],\n",
    "    'City': ['Chennai', 'Madurai', 'Chennai', 'Chennai']\n",
    "})\n",
    "\n",
    "df['SalaryLevel'] = np.where(\n",
    "    df['Salary'] >= 50000, 'High',\n",
    "    np.where(df['Salary'] >= 40000, 'Medium', 'Low')\n",
    ")\n",
    "\n",
    "print(df[['Name', 'Salary', 'SalaryLevel']])\n"
   ]
  },
