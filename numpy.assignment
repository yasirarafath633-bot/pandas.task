    "    \"Department\": [\"IT\", \"HR\", \"IT\", \"Finance\", \"IT\",\n",
    "                   \"HR\", \"Finance\", \"IT\", \"Sales\", \"Sales\"],\n",
    "    \"Age\": [25, 29, 32, 27, 24, 35, 31, 28, 30, 26],\n",
    "    \"Salary\": [35000, 42000, 58000, 39000, 30000,\n",
    "               62000, 51000, 47000, 44000, 36000],\n",
