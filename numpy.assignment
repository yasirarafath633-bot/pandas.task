   "metadata": {},
   "source": [
    "## Answer a business question ##"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "id": "602fc1e4-32b0-482e-809e-df232397e3ca",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Department with highest average salary: IT\n",
      "Highest average salary: 46500.0\n",
      "\n",
      "Overall average salary: 43500.0\n",
      "\n",
      "Employees earning above overall average:\n",
      "    Name Department  Salary\n",
      "2  Kumar         IT   58000\n"
     ]
    }
   ],
   "source": [
    "\n",
    "import pandas as pd\n",
    "\n",
    "df = pd.DataFrame({\n",
    "    'EmpID': [101, 102, 103, 104],\n",
    "    'Name': ['Arun', 'Priya', 'Kumar', 'Divya'],\n",
    "    'Department': ['IT', 'HR', 'IT', 'Finance'],\n",
    "    'Age': [25, 29, 32, 27],\n",
    "    'Salary': [35000, 42000, 58000, 39000],\n",
    "    'Experience': [2, 5, 8, 3],\n",
    "    'City': ['Chennai', 'Madurai', 'Chennai', 'Chennai']\n",
    "})\n",
    "\n",
    "dept_avg = df.groupby('Department')['Salary'].mean()\n",
    "\n",
    "highest_dept = dept_avg.idxmax()\n",
    "highest_avg = dept_avg.max()\n",
    "\n",
    "print(\"Department with highest average salary:\", highest_dept)\n",
    "print(\"Highest average salary:\", highest_avg)\n",
    "\n",
    "overall_avg = df['Salary'].mean()\n",
    "print(\"\\nOverall average salary:\", overall_avg)\n",
    "\n",
    "above_avg = df[df['Salary'] > overall_avg]\n",
    "\n",
    "print(\"\\nEmployees earning above overall average:\")\n",
    "print(above_avg[['Name', 'Department', 'Salary']])\n"
   ]
  },
