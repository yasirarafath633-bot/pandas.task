  {
   "cell_type": "markdown",
   "id": "243e79bd-f6c7-4779-b48b-1ddb821295ed",
   "metadata": {},
   "source": [
    "## Filter employee records ###"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "af975dc3-0855-472b-babd-b172517fd2ee",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "   EmpID   Name Department  Age  Salary  Experience     City\n",
      "2    103  Kumar         IT   32   58000           8  Chennai\n"
     ]
    }
   ],
   "source": [
    "\n",
    "import pandas as pd\n",
    "\n",
    "df = pd.DataFrame({\n",
    "    'EmpID': [101, 102, 103, 104],\n",
    "    'Name': ['Arun', 'Priya', 'Kumar', 'Divya'],\n",
    "    'Department': ['IT', 'HR', 'IT', 'Finance'],\n",
    "    'Age': [25, 29, 32, 27],\n",
    "    'Salary': [35000, 42000, 58000, 39000],\n",
    "    'Experience': [2, 5, 8, 3],\n",
    "    'City': ['Chennai', 'Madurai', 'Chennai', 'Chennai']\n",
    "})\n",
    "\n",
    "result = df[(df['Department'] == 'IT') & (df['Salary'] > 40000)]\n",
    "\n",
    "print(result)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a2fc7eba-e756-4a69-829f-a7511149ad74",
